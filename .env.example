# Copy to .env and fill in only what you actually use. .env is gitignored
# and must never be committed. Nothing in records/ ever carries a value
# from this file — scripts read these by NAME.

# Escalation channel (Lesson 11). Pick one in records/ops/channel.json.
# Slack, Discord or anything that accepts a JSON POST:
BYB_WEBHOOK_URL=

# Or email, if you would rather get the exceptions in your inbox:
BYB_SMTP_HOST=
BYB_SMTP_USER=
BYB_SMTP_PASS=

# Per-agent credentials (Lesson 9). One scoped key per agent, named in
# that agent's spec.json under "credentials", so you can revoke one
# without touching the others. Read-only wherever the job allows.
# Examples, rename them for your own agents:
# BYB_SUPPORT_DRAFTS_SHOPIFY_TOKEN=
# BYB_CONTENT_QUEUE_API_KEY=

# A JSON endpoint a Mission Control tile pulls from (Lesson 10).
# BYB_METRIC_URL=

# How often the container ticks, if you run the Docker host.
HERMES_TICK_MINUTES=5
