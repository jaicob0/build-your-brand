# Copy to .env and fill in only what you actually use. .env is gitignored
# and must never be committed. Nothing in records/ ever carries a value
# from this file — scripts read these by NAME.

# Escalation channel (Lesson 11). Pick one in records/ops/channel.json.
# Slack, Discord or anything that accepts a JSON POST:
BYB_WEBHOOK_URL=

# Or email, if you would rather get the exceptions in your inbox:
BYB_SMTP_HOST=
BYB_SMTP_USER=
BYB_SMTP_PASS=

# Per-agent credentials (Lesson 9). One scoped key per agent, named in
# that agent's spec.json under "credentials", so you can revoke one
# without touching the others. Read-only wherever the job allows.
# Examples, rename them for your own agents:
# BYB_SUPPORT_DRAFTS_SHOPIFY_TOKEN=
# BYB_CONTENT_QUEUE_API_KEY=

# Mission Control tiles (Lesson 10). All optional: the free path reads
# your disk and needs none of these. A tile whose key is absent renders
# as a labelled placeholder rather than a wrong number.

# A JSON endpoint, with optional bearer auth:
# BYB_METRIC_URL=
# BYB_METRIC_TOKEN=

# YouTube Data API v3 (the three-call chain: channel, search, videos):
# BYB_YOUTUBE_KEY=

# Apify, for social scraping. Run the actor, then point at its dataset:
# BYB_APIFY_TOKEN=
# BYB_APIFY_DATASET=

# Shopify Admin API, read-only scopes only:
# BYB_SHOPIFY_SHOP=yourshop.myshopify.com
# BYB_SHOPIFY_TOKEN=

# The local generator proxy (scripts/proxy.js) uses your existing Claude
# Code login and needs no key at all. This only changes its port.
# PROXY_PORT=3001

# Halt every agent at once without touching the repo. The kill switch
# file records/ops/HALT does the same thing.
# HERMES_HALT=1

# How often the container ticks, if you run the Docker host.
HERMES_TICK_MINUTES=5
